# Copy to .env. With no changes, everything targets the bundled mock chatbot.

# --- LLM judge (DeepEval). Needed only for stage 3 and `make generate-golden`.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EVAL_JUDGE_PROVIDER=openai        # openai | anthropic
EVAL_JUDGE_MODEL=                 # pin a model for comparable scores across runs
DEEPEVAL_TELEMETRY_OPT_OUT=YES

# --- Target chatbot. Change these to gate a real staging bot.
CHATBOT_BASE_URL=http://127.0.0.1:8080
CHATBOT_CHANNEL=api               # which adapter the LLM evals use: api | ui
CHATBOT_API_KEY=                  # sent as "Authorization: Bearer <key>"

# REST contract: request field names and dotted paths into the JSON response
CHATBOT_API_PATH=/api/chat
CHATBOT_HEALTH_PATH=/healthz
CHATBOT_API_SESSION_FIELD=session_id
CHATBOT_API_MESSAGE_FIELD=message
CHATBOT_API_REPLY_FIELD=reply
CHATBOT_API_CONTEXT_FIELD=retrieval_context
CHATBOT_API_ESCALATED_FIELD=escalated

# Widget contract: page path and CSS selectors
CHATBOT_WIDGET_PATH=/
CHATBOT_SEL_LAUNCHER=[data-testid="chat-launcher"]
CHATBOT_SEL_INPUT=[data-testid="chat-input"]
CHATBOT_SEL_SEND=[data-testid="chat-send"]
CHATBOT_SEL_BOT_MESSAGE=[data-testid="bot-message"]
CHATBOT_SEL_USER_MESSAGE=[data-testid="user-message"]
CHATBOT_SEL_TYPING=[data-testid="typing-indicator"]
CHATBOT_SEL_HANDOFF=[data-testid="handoff-banner"]
CHATBOT_HEADLESS=true

# Budgets and guardrails
CHATBOT_API_LATENCY_BUDGET_MS=3000
CHATBOT_UI_LATENCY_BUDGET_MS=6000
CHATBOT_CANARY_TOKENS=NIMBUS-CANARY-7731
CHATBOT_EXPECT_CHANNEL_PARITY=true    # set false for a non-deterministic (LLM) bot
CHATBOT_GOLDEN_DIR=datasets/golden

# --- Mock chatbot only: inject a regression to watch the gate fail
MOCK_BOT_FAULT=none               # none | hallucinate | forget | leak
